[core]
	repositoryformatversion = 0
	filemode = true
	bare = false
	logallrefupdates = true
	ignorecase = true
	precomposeunicode = true
	hooksPath = .husky/_
[remote "origin"]
	url = https://github.com/tweezerchef/financel
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
	github-pr-owner-number = "Financel-Corp#financel#147"
	vscode-merge-base = origin/main
[remote "upstream"]
	url = https://github.com/Financel-Corp/financel.git
	fetch = +refs/heads/*:refs/remotes/upstream/*
[pull]
	rebase = false
[remote "upstreamDev"]
	url = https://github.com/Financel-Corp/financelDev.git
	fetch = +refs/heads/*:refs/remotes/upstreamDev/*
[branch "Flip"]
	vscode-merge-base = origin/main
[branch "share"]
	github-pr-base-branch = "Financel-Corp#financel#main"
	vscode-merge-base = origin/main
